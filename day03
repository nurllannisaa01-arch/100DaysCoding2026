public class day03 {
    
    public static void main(String[] args) {
        // \n= pindah kebaris baru
        System.out.println("Hallo\nGess");
        // \t= tab / membuat jarak seperti teb
        System.out.println("Nama:\tNurul");
        // \"= menampilkan tanda kutip dua
        System.out.println("Saya berkata: \"Hallo!\"");
        // \,= menampilkan tanda kutip satu
        System.out.println("Saya suka \'Makan\'");
        // \b= backspace
        System.out.println("AB\bC");
    }
    
}
